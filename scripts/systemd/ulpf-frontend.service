[Unit]
Description=ULPF Next.js SOC Analyst Dashboard
After=network.target ulpf-backend.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/layaRustparser/frontend/laya-frontend
ExecStart=/usr/bin/npm run start -- -p 3000 -H 0.0.0.0
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=BACKEND_URL=http://127.0.0.1:8080
StandardOutput=append:/home/ubuntu/layaRustparser/frontend.log
StandardError=append:/home/ubuntu/layaRustparser/frontend.log

[Install]
WantedBy=multi-user.target
